# Copy these into Portainer > Stacks > Add stack > Environment variables (or "Load variables from .env file").

# The TrueNAS dataset holding both photo folders, e.g. /mnt/tank/photos
PHOTOS_DATASET=/mnt/tank/photos
# Folder names inside that dataset
DUMP_FOLDER=Dumpsite
PUBLISHED_FOLDER=Published Pics

# Where the app keeps its database, model files (~1.8 GB) and previews, e.g. a dataset under your apps pool
APPDATA_PATH=/mnt/tank/apps/aves-caesar

# Run as the user and group that own PHOTOS_DATASET (TrueNAS > Datasets > Permissions).
# 568 is the built-in "apps" user; use your own user's ID if your SMB share is owned by you.
PUID=568
PGID=568

# Required: database password (also used by other apps that read the database)
POSTGRES_PASSWORD=change-me
# Host port for the database, for other applications. Remove the "ports" entry of "db" to keep it private.
POSTGRES_PORT=5433

# Web UI port: http://<truenas-ip>:8095
AVES_PORT=8095
# Optional: password for the web UI and API (any username). Leave empty on a trusted network.
AVES_PASSWORD=

# auto picks the best available; cpu forces the CPU. With compose.nvidia.yaml the default becomes cuda.
AVES_PROVIDER=auto

# Optional: identify birds on a Windows PC's GPU (see README, "Using a Windows PC's GPU")
AVES_REMOTE_URL=
AVES_REMOTE_TOKEN=
# When the PC is off: local = use the NAS processor meanwhile, wait = hold photos until the PC is back
AVES_REMOTE_FALLBACK=local
TZ=Asia/Kolkata
